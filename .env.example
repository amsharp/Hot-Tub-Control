# ---------------------------------------------------------------------------
# Hot-Tub-Control configuration. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Bestway / Lay-Z-Spa account (the same login you use in the app) --------
BESTWAY_USERNAME=you@example.com
BESTWAY_PASSWORD=your-app-password
# Gizwits region for your account: "eu" or "us". Most non-US users are "eu".
BESTWAY_REGION=eu
# Optional: pin a specific pump by its device id (DID). If unset, the first
# spa found on the account is used. Run `npm run cli -- devices` to list them.
BESTWAY_DEVICE_ID=
# Optional: keep the pump pinned to this display unit ("F" or "C"). A mains
# power-cycle resets the pump to Celsius; when set, the service flips it back
# automatically (on startup and each watchdog cycle). Leave empty to leave it.
ENFORCE_UNIT=

# --- HTTP server ------------------------------------------------------------
PORT=3000
# Where to store runtime state (OAuth tokens + schedules). Leave unset for
# local use (./data). On Railway/Fly/etc. set this to a mounted volume path
# (e.g. /data) so links and schedules survive redeploys.
DATA_DIR=
# Public HTTPS base URL where Google reaches this service (no trailing slash).
# e.g. https://spa.example.com  — required for Google account linking to work.
PUBLIC_BASE_URL=https://spa.example.com

# --- Google account linking (OAuth2 — you choose these values) --------------
# These are the Client ID / Secret you enter in the Actions console > Account
# linking. They gate who may link the Action to your spa (i.e. just you).
OAUTH_CLIENT_ID=google-actions-client-id
OAUTH_CLIENT_SECRET=change-me-to-a-long-random-string
# Simple gate for the consent screen: the credentials you type when linking.
LINK_USERNAME=owner
LINK_PASSWORD=change-me

# --- Optional: Google Home Graph (proactive state + auto re-sync) -----------
# Path to a Google Cloud service-account JSON with the Home Graph API enabled.
# Leave blank to disable reportState/requestSync (everything else still works).
HOMEGRAPH_SERVICE_ACCOUNT_FILE=

# --- Optional: notifications ------------------------------------------------
# A webhook that receives a JSON POST on status/alerts (e.g. ntfy, Slack,
# Discord, Home Assistant webhook). Leave blank to disable.
NOTIFY_WEBHOOK_URL=

# Temperature unit for display/logs: "C" or "F".
DISPLAY_UNIT=C

# --- Fault watchdog (auto-clear "low flow" / E02) ---------------------------
# When the pump reports a transient low-flow fault it beeps until cleared. The
# watchdog detects it, restarts circulation to clear it, and warns you.
AUTO_CLEAR_LOW_FLOW=true
# How often to poll for faults (minutes). Lower = caught/cleared faster.
WATCHDOG_INTERVAL_MIN=2
# How many auto-restarts to try before backing off and asking you to check the
# water level / filter (physical causes can't be fixed remotely).
WATCHDOG_MAX_ATTEMPTS=3
# Minimum minutes between restart attempts for the same fault.
WATCHDOG_COOLDOWN_MIN=15
# React to faults in real time via the Gizwits push WebSocket (recommended).
# Falls back to polling automatically if the socket can't connect.
REALTIME_ENABLED=true
